generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  fullName     String
  username     String?  @unique
  title        String?
  avatarUrl    String?
  avatarColor  String?
  isGuest      Boolean  @default(false)
  passwordHash String?
  googleId     String?  @unique
  theme        String   @default("light") // "light" | "dark"
  colorMode    String   @default("blue") // "amber" | "blue" | "pink" | "rose" | "emerald" | "black"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects   Project[] @relation("ProjectOwner")
  ledProjects     Project[] @relation("ProjectLead")
  ownedTasks      Task[]    @relation("TaskOwner")
  assignedTasks   Task[]    @relation("TaskAssignee")
  reportedTasks   Task[]    @relation("TaskReporter")
  memberOfTasks   TaskMember[]
  comments        Comment[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------
model Project {
  id        String    @id @default(cuid())
  name      String
  priority  String    @default("no_priority") // no_priority | urgent | high | medium | low
  dueDate   DateTime?
  leadId    String?
  lead      User?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasks Task[]

  @@map("projects")
}

// ---------------------------------------------------------------------------
// Task
// ---------------------------------------------------------------------------
model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("todo") // todo | doing | completed | on_hold
  priority     String    @default("no_priority") // no_priority | urgent | high | medium | low
  dueDate      DateTime?
  order        Int       @default(0)

  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  parentTaskId String?
  parentTask   Task?     @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]    @relation("TaskSubtasks")

  assigneeId   String?
  assignee     User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId   String?
  reporter     User?     @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  ownerId      String?
  owner        User?     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members   TaskMember[]
  labels    TaskLabel[]
  comments  Comment[]
  resources Resource[]

  @@map("tasks")
}

// ---------------------------------------------------------------------------
// TaskMember (join table Task <-> User, the "members" avatar stack)
// ---------------------------------------------------------------------------
model TaskMember {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_members")
}

// ---------------------------------------------------------------------------
// Label
// ---------------------------------------------------------------------------
model Label {
  id         String @id @default(cuid())
  name       String @unique
  colorToken String?

  tasks TaskLabel[]

  @@map("labels")
}

// ---------------------------------------------------------------------------
// TaskLabel (join table Task <-> Label)
// ---------------------------------------------------------------------------
model TaskLabel {
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

// ---------------------------------------------------------------------------
// Comment
// ---------------------------------------------------------------------------
model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@map("comments")
}

// ---------------------------------------------------------------------------
// Resource (documents / links attached to a task)
// ---------------------------------------------------------------------------
model Resource {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())

  @@map("resources")
}
