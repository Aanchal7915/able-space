# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# SQLite file, relative to the backend/ directory. For production you can
# swap this for a Postgres connection string and change the `provider` in
# prisma/schema.prisma without touching application code.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="dev-secret-change-me"
# How long an access token stays valid, e.g. "7d", "12h", "3600s".
JWT_EXPIRES_IN="7d"

# --- CORS ---
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN="http://localhost:3000"

# --- Google OAuth (optional) ---
# If any of these are unset, GET /api/auth/google and /api/auth/google/callback
# respond with 501 instead of crashing the app at boot.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
